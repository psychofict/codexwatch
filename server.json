{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.psychofict/codexwatch",
  "title": "codexwatch",
  "description": "OpenAI Codex usage from your local logs: tokens, API-equivalent cost and plan limits.",
  "repository": {
    "url": "https://github.com/psychofict/codexwatch",
    "source": "github"
  },
  "websiteUrl": "https://github.com/psychofict/codexwatch",
  "version": "1.0.2",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "codexwatch-cli",
      "version": "1.0.2",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
